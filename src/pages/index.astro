---
import Layout from "@/layouts/Layout.astro";

import { oss } from "@/data/oss";
import { talks } from "@/data/talks";
import { langs } from "@/data/langs";
import { civic } from "@/data/civic";
import { advent } from "@/data/advent";
import { essays } from "@/data/essays";
import { stories } from "@/data/stories";
import { socials } from "@/data/socials";
import { languages } from "@/data/languages";

import Projects from "@/components/Projects";
---

<Layout title="Frectonz" description="frectonz's website">
  <header class="my-6 sm:my-10 grid intro-about-grid gap-5">
    <div class="sm:min-h-[300px] border border-black flex flex-col box-shadow">
      <section
        class="p-4 grow flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-start"
      >
        <img
          src="me.webp"
          alt="Fraol"
          class="w-20 h-20 sm:w-28 sm:h-28 rounded-full border border-black object-cover"
        />
        <h1 class="text-2xl sm:text-4xl">
          Hi, I'm
          <span class="font-serif font-bold">fraol</span> or
          <br />
          <span class="font-serif font-bold">frectonz</span> on the internet.
        </h1>
      </section>
      <section class="p-4 border-t border-black flex gap-2 items-center">
        {
          socials.map((social) => (
            <a
              href={social.link}
              title={social.name}
              aria-label={`Checkout frectonz's ${social.name.toLowerCase()} profile`}
              class="hover:scale-110"
            >
              <social.icon size="2rem" />
            </a>
          ))
        }
      </section>

      <section class="p-4 border-t border-black flex gap-5 items-center">
        <p class="leading-loose">
          I have a <a
            href="https://telegram.me/s/thefrectonz"
            class="bg-black text-white p-0.5">telegram channel</a
          > and a <a
            href="https://www.youtube.com/@frectonz"
            class="bg-black text-white p-0.5">youtube channel</a
          >.
        </p>
      </section>

      <section class="p-4 border-t border-black flex gap-5 items-center">
        <p>
          I also host a tech podcast called <a
            href="https://www.youtube.com/@thedevtopia"
            class="bg-black text-white p-0.5">Devtopia</a
          >.
        </p>
      </section>
    </div>

    <section
      class="sm:min-h-[300px] p-4 border border-black box-shadow bg-black text-white"
    >
      <h1 class="text-2xl sm:text-3xl font-bold pb-4">About Me</h1>
      <p class="text-base sm:text-xl">
        I have been interested in technology and its ability to influence our
        life for as long as I remember. This interest has lead into the world of
        software development which I enjoy very much.
      </p>
    </section>
  </header>

  <section class="my-6 sm:my-10">
    <p class="text-base sm:text-xl leading-relaxed">
      I am currently working on a publication called <a
        href="https://overdueprogress.org"
        class="bg-black text-white p-0.5">Overdue Progress</a
      >, dedicated to understanding how progress happens and how to make more of
      it, with a focus on Africa.
    </p>
  </section>

  <article>
    <h1 class="font-serif text-xl sm:text-3xl mb-4">
      Programming Languages I work with
    </h1>
    <div class="flex gap-2 flex-wrap">
      {
        languages.map((lang) => (
          <a
            href={lang.link}
            title={lang.name}
            class="hover:scale-110"
            target="_blank"
          >
            <lang.icon size="2rem" />
          </a>
        ))
      }
    </div>
  </article>

  <section class="my-6 sm:my-10">
    <h1 class="text-2xl sm:text-4xl font-serif mb-5 font-bold">Projects</h1>
    <Projects client:load />
    <a
      href="https://github.com/frectonz?tab=repositories"
      class="font-serif underline text-xl">See more on GitHub</a
    >
  </section>

  <section class="my-6 sm:my-10">
    <h1 class="text-2xl sm:text-4xl font-serif mb-5 font-bold">
      Civic Projects
    </h1>
    <ul class="flex gap-3 overflow-x-auto pb-2">
      {
        civic.map((p) => (
          <li class="min-w-[240px] w-[240px] sm:min-w-[300px] sm:w-[300px] border border-black box-shadow p-3 flex flex-col gap-1.5">
            <div class="flex items-baseline justify-between gap-x-3">
              <h1 class="font-serif font-bold">{p.name}</h1>
              <div class="flex gap-3 text-sm shrink-0">
                <a class="underline" href={p.code}>
                  Source
                </a>
                <a class="underline" href={p.url}>
                  Site
                </a>
              </div>
            </div>
            <p class="font-serif text-sm leading-snug">{p.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="my-6 sm:my-10">
    <h1 class="text-2xl sm:text-4xl font-serif mb-5 font-bold">
      OSS Contributions
    </h1>
    <ul class="flex gap-3 overflow-x-auto pb-2">
      {
        oss.map((p) => (
          <li class="min-w-[240px] w-[240px] sm:min-w-[300px] sm:w-[300px] border border-black box-shadow p-3 flex flex-col gap-1.5">
            <div class="flex items-baseline justify-between gap-x-3">
              <h1 class="font-serif font-bold">{p.name}</h1>
              <a class="underline text-sm shrink-0" href={p.prs}>
                PRs
              </a>
            </div>
            <p class="font-serif text-sm leading-snug">{p.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="my-6 sm:my-10">
    <h1 class="text-2xl sm:text-4xl font-serif mb-5 font-bold">
      Language Forks
    </h1>
    <ul class="flex gap-3 overflow-x-auto pb-2">
      {
        langs.map((l) => (
          <li class="min-w-[240px] w-[240px] sm:min-w-[300px] sm:w-[300px] border border-black box-shadow p-3 flex flex-col gap-1.5">
            <div class="flex items-baseline justify-between gap-x-3">
              <h1 class="font-serif font-bold">{l.name}</h1>
              <a class="underline text-sm shrink-0" href={l.code}>
                Source
              </a>
            </div>
            <p class="font-serif text-sm leading-snug">{l.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="my-6 sm:my-10">
    <h1 class="text-2xl sm:text-4xl font-serif mb-5 font-bold">
      Advent of Code
    </h1>
    <ul class="flex gap-3 overflow-x-auto pb-2">
      {
        advent.map((a) => (
          <li class="min-w-[180px] w-[180px] sm:min-w-[220px] sm:w-[220px] border border-black box-shadow p-3 flex flex-col gap-1.5">
            <div class="flex items-baseline gap-2">
              <p class="text-xs">Solutions for</p>
              <h1 class="font-serif font-bold text-xl">{a.year}</h1>
            </div>
            <div class="flex items-baseline justify-between gap-x-4">
              <p class="text-xs">{a.days} days</p>
              <a class="underline text-sm shrink-0" href={a.code}>
                Source
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="my-6 sm:my-10">
    <h1 class="text-2xl sm:text-4xl font-serif mb-5 font-bold">Talks</h1>
    <div class="flex gap-5 overflow-x-auto pb-2">
      {
        talks.map((t) => (
          <div class="min-w-[280px] w-[280px] sm:min-w-[400px] sm:w-[400px] flex flex-col border border-black box-shadow">
            <div class="p-4">
              <h1 class="font-serif text-xl font-bold">{t.name}</h1>
            </div>

            <div class="p-4 border-t border-black grow">
              <p class="font-serif">{t.event}</p>
            </div>

            <div class="p-4 flex gap-4 justify-end">
              <a
                class="underline"
                href={t.slides}
                target="_blank"
                rel="noopener noreferrer"
              >
                View Slides
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="my-6 sm:my-10">
    <h1 class="text-2xl sm:text-4xl font-serif mb-5 font-bold">Essays</h1>
    <main>
      <ul class="grid grid-cols-1 gap-3">
        {
          essays.map((essay) => (
            <li class="border border-black box-shadow">
              <a
                href={`/essays/${essay.slug}`}
                class="flex flex-col sm:flex-row sm:justify-between transition-colors hover:bg-black hover:text-white"
              >
                <h1 class="p-2">{essay.name}</h1>
                <p class="border-t sm:border-t-0 sm:border-l border-black p-2 font-serif">
                  {essay.publishedOn}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </section>

  <section class="my-6 sm:my-10">
    <h1 class="text-2xl sm:text-4xl font-serif mb-5 font-bold">Stories</h1>
    <main>
      <ul class="grid grid-cols-1 gap-3">
        {
          stories.map((story) => (
            <li class="border border-black box-shadow">
              <a
                href={`/stories/${story.slug}`}
                class="flex flex-col sm:flex-row sm:justify-between transition-colors hover:bg-black hover:text-white"
              >
                <h1 class="p-2">{story.name}</h1>
                <p class="border-t sm:border-t-0 sm:border-l border-black p-2 font-serif">
                  {story.publishedOn}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </section>
</Layout>

<style>
  .intro-about-grid {
    grid-template-columns: 60% 40%;
  }

  @media (max-width: 900px) {
    .intro-about-grid {
      grid-template-columns: 100%;
    }
  }

  * {
    animation: animate-in 1s ease-in-out;
  }

  @keyframes animate-in {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
