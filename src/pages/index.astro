---
import Layout from "@/layouts/Layout.astro";

import { oss } from "@/data/oss";
import { talks } from "@/data/talks";
import { langs } from "@/data/langs";
import { civic } from "@/data/civic";
import { advent } from "@/data/advent";
import { essays } from "@/data/essays";
import { stories } from "@/data/stories";
import { languages } from "@/data/languages";
import { initiatives } from "@/data/initiatives";

import Projects from "@/components/Projects";
import Intro from "@/components/Intro.astro";
import Section from "@/components/Section.astro";
import CardRow from "@/components/CardRow.astro";
import LinkCard from "@/components/LinkCard.astro";
import TalkCard from "@/components/TalkCard.astro";
import PostList from "@/components/PostList.astro";
import IconLinks from "@/components/IconLinks.astro";
import AdventCard from "@/components/AdventCard.astro";
---

<Layout title="Frectonz" description="frectonz's website">
  <div class="animate-in">
    <Intro />

    <article>
      <h1 class="font-serif text-xl sm:text-3xl mb-4">
        Programming Languages I work with
      </h1>
      <div class="flex gap-2 flex-wrap">
        <IconLinks links={languages} newTab />
      </div>
    </article>

    <Section title="Projects">
      <Projects client:load />
      <a
        href="https://github.com/frectonz?tab=repositories"
        class="font-serif underline text-xl">See more on GitHub</a
      >
    </Section>

    <Section title="Personal Initiatives">
      <CardRow>
        {
          initiatives.map((p) => (
            <LinkCard
              size="wide"
              name={p.name}
              description={p.description}
              links={[
                { label: "Source", href: p.code },
                { label: "Site", href: p.url },
              ]}
            />
          ))
        }
      </CardRow>
    </Section>

    <Section title="Civic Projects">
      <CardRow>
        {
          civic.map((p) => (
            <LinkCard
              name={p.name}
              description={p.description}
              links={[
                { label: "Source", href: p.code },
                { label: "Site", href: p.url },
              ]}
            />
          ))
        }
      </CardRow>
    </Section>

    <Section title="OSS Contributions">
      <CardRow>
        {
          oss.map((p) => (
            <LinkCard
              name={p.name}
              description={p.description}
              links={[{ label: "PRs", href: p.prs }]}
            />
          ))
        }
      </CardRow>
    </Section>

    <Section title="Language Forks">
      <CardRow>
        {
          langs.map((l) => (
            <LinkCard
              name={l.name}
              description={l.description}
              links={[{ label: "Source", href: l.code }]}
            />
          ))
        }
      </CardRow>
    </Section>

    <Section title="Advent of Code">
      <CardRow>
        {
          advent.map((a) => (
            <AdventCard year={a.year} days={a.days} code={a.code} />
          ))
        }
      </CardRow>
    </Section>

    <Section title="Talks">
      <CardRow gap={5}>
        {
          talks.map((t) => (
            <TalkCard name={t.name} event={t.event} slides={t.slides} />
          ))
        }
      </CardRow>
    </Section>

    <Section title="Essays">
      <PostList posts={essays} base="/essays" />
    </Section>

    <Section title="Stories">
      <PostList posts={stories} base="/stories" />
    </Section>
  </div>
</Layout>
