---
import Card from "@/components/Card.astro";

export interface CardLink {
  label: string;
  href: string;
}

export interface Props {
  name: string;
  description: string;
  links: CardLink[];
  linksPosition?: "top" | "bottom";
}

const { name, description, links, linksPosition = "top" } = Astro.props;
---

<Card
  class="min-w-[240px] w-[240px] sm:min-w-[300px] sm:w-[300px] p-3 flex flex-col gap-1.5"
>
  {
    linksPosition === "top" ? (
      <div class="flex items-baseline justify-between gap-x-3">
        <h1 class="font-serif font-bold">{name}</h1>
        <div class="flex gap-3 text-sm shrink-0">
          {links.map((link) => (
            <a class="underline" href={link.href}>
              {link.label}
            </a>
          ))}
        </div>
      </div>
    ) : (
      <h1 class="font-serif font-bold">{name}</h1>
    )
  }
  <p class="font-serif text-sm leading-snug">{description}</p>
  {
    linksPosition === "bottom" && (
      <div class="flex gap-3 text-sm mt-auto pt-1">
        {links.map((link) => (
          <a class="underline" href={link.href}>
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</Card>
