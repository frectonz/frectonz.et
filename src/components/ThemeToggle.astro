---
import { RxMoon, RxSun } from "react-icons/rx";
---

<button
  id="theme-toggle"
  type="button"
  class="fixed top-0.5 right-0.5 z-50 w-7 h-7 border border-ink bg-paper flex items-center justify-center cursor-pointer transition-colors hover:bg-ink hover:text-paper"
  title="Switch to dark theme"
  aria-label="Switch to dark theme"
>
  <span class="block dark:hidden"><RxMoon size="1rem" /></span>
  <span class="hidden dark:block"><RxSun size="1rem" /></span>
</button>

<script>
  type Theme = "light" | "dark";

  const root = document.documentElement;
  const button = document.getElementById("theme-toggle")!;
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

  const resolved = (): Theme => {
    const theme = root.dataset.theme;
    if (theme === "light" || theme === "dark") return theme;
    return systemDark.matches ? "dark" : "light";
  };

  const syncLabel = () => {
    const label = `Switch to ${resolved() === "dark" ? "light" : "dark"} theme`;
    button.title = label;
    button.setAttribute("aria-label", label);
  };

  button.addEventListener("click", () => {
    const theme: Theme = resolved() === "dark" ? "light" : "dark";
    root.dataset.theme = theme;
    try {
      sessionStorage.setItem("theme", theme);
    } catch {}
    syncLabel();
  });

  systemDark.addEventListener("change", syncLabel);
  syncLabel();
</script>
