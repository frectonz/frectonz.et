---
import IconLinks from "@/components/IconLinks.astro";

import { socials } from "@/data/socials";
---

<header class="my-6 sm:my-10 grid intro-about-grid gap-5">
  <div class="sm:min-h-[300px] border border-black flex flex-col box-shadow">
    <section
      class="p-4 grow flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-start"
    >
      <img
        src="me.webp"
        alt="Fraol"
        class="w-20 h-20 sm:w-28 sm:h-28 rounded-full border border-black object-cover"
      />
      <h1 class="text-2xl sm:text-4xl">
        Hi, I'm
        <span class="font-serif font-bold">fraol</span> or
        <br />
        <span class="font-serif font-bold">frectonz</span> on the internet.
      </h1>
    </section>

    <section class="p-4 border-t border-black flex gap-2 items-center">
      <IconLinks
        links={socials}
        label={(name) => `Checkout frectonz's ${name.toLowerCase()} profile`}
      />
    </section>

    <section class="p-4 border-t border-black flex gap-5 items-center">
      <p class="leading-loose">
        I have a <a
          href="https://telegram.me/s/thefrectonz"
          class="bg-black text-white p-0.5">telegram channel</a
        > and a <a
          href="https://www.youtube.com/@frectonz"
          class="bg-black text-white p-0.5">youtube channel</a
        >.
      </p>
    </section>

    <section class="p-4 border-t border-black flex gap-5 items-center">
      <p>
        I also host a tech podcast called <a
          href="https://www.youtube.com/@thedevtopia"
          class="bg-black text-white p-0.5">Devtopia</a
        >.
      </p>
    </section>
  </div>

  <section
    class="sm:min-h-[300px] p-4 border border-black box-shadow !bg-black text-white"
  >
    <h1 class="text-2xl sm:text-3xl font-bold pb-4">About Me</h1>
    <p class="text-base sm:text-xl">
      I have been interested in technology and its ability to influence our life
      for as long as I remember. This interest has lead into the world of
      software development which I enjoy very much.
    </p>
  </section>
</header>

<style>
  .intro-about-grid {
    grid-template-columns: 60% 40%;
  }

  @media (max-width: 900px) {
    .intro-about-grid {
      grid-template-columns: 100%;
    }
  }
</style>
